<!--
     SPDX-License-Identifier: Apache-2.0
     Copyright 2026 The DiamaneOS Project

     IMS network broker: files the IMS and emergency (EIMS) cellular network
     requests the vendor IMS DCM daemon asks for.

     - One privileged permission, CONNECTIVITY_USE_RESTRICTED_NETWORKS, which
       ConnectivityService requires for the restricted IMS and EIMS requests.
       INTERNET (the revocable Network permission on our base) lets Android track this
       persistent UID in its background firewall. Without it, Android 17
       reports connected IMS bearers as blocked for the broker. SELinux
       still forbids IP/raw/modem sockets; the broker sends no network traffic.
       No location or phone-state permission (getSubscriptionId needs none).
     - No components: nothing can bind to it, start it or send it intents.
     - persistent and directBootAware: running at boot, before the first
       unlock, as emergency IMS needs.
     - Built with sdk_version "module_current"; Soong therefore sets
       android:usesNonSdkApi (the module-lib ServiceManager calls it makes are
       outside the public SDK list).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.diamaneos.imsbroker">

    <uses-permission android:name="android.permission.CONNECTIVITY_USE_RESTRICTED_NETWORKS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ImsBrokerApp"
        android:label="@string/app_name"
        android:persistent="true"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true"
        android:allowBackup="false" />
</manifest>
