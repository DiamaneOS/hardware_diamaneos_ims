// SPDX-License-Identifier: Apache-2.0
// Copyright 2026 The DiamaneOS Project
package { default_applicable_licenses: ["diamaneos_ims_license"] }
license {
    name: "diamaneos_ims_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}
java_library {
    name: "DiamaneOSImsAddressPolicy",
    srcs: ["common/src/**/*.java"],
    sdk_version: "current",
    visibility: [":__subpackages__"],
}
rust_library {
    name: "libdiamaneos_ims_dcm", crate_name: "diamaneos_ims_dcm",
    srcs: ["dcm/src/lib.rs"], edition: "2021", vendor_available: true,
    host_supported: true,
}
rust_library {
    name: "libdiamaneos_ims_runtime", crate_name: "diamaneos_ims_runtime",
    srcs: ["daemon/src/lib.rs"], edition: "2021", vendor_available: true,
    rustlibs: ["libdiamaneos_ims_dcm", "liblibc"],
}
rust_binary {
    name: "imsdcmd", srcs: ["daemon/src/main.rs"], edition: "2021", vendor: true,
    rustlibs: ["libbinder_rs", "liblibc", "librustutils",
        "libdiamaneos_ims_dcm", "libdiamaneos_ims_runtime",
        "vendor.diamaneos.hardware.imsdcm-V1-rust"],
    vintf_fragment_modules: ["vendor.diamaneos.hardware.imsdcm.xml"],
    required: ["imsdcmd.rc", "imsdcmd-control.rc"],
}
rust_test_host {
    name: "DiamaneOSImsDcmHostTests", srcs: ["dcm/tests/simulation.rs"], edition: "2021",
    rustlibs: ["libdiamaneos_ims_dcm"],
    test_options: { unit_test: true },
}
rust_library {
    name: "libdiamaneos_wlan_reporting", crate_name: "diamaneos_wlan_reporting",
    srcs: ["wlan/src/lib.rs"], edition: "2021", host_supported: true,
    rustlibs: ["libdiamaneos_ims_dcm"],
}
rust_library {
    name: "libdiamaneos_wlan_runtime", crate_name: "diamaneos_wlan_runtime",
    srcs: ["wlan-runtime/src/lib.rs"], edition: "2021", host_supported: true,
    rustlibs: ["libdiamaneos_wlan_reporting"],
}
rust_binary {
    name: "wlanreportd", srcs: ["wlan-runtime/src/main.rs"], edition: "2021",
    // PRIVATE EXPERIMENT ONLY. Runtime also requires immutable ro.debuggable.
    // Remove this cfg and the diagnostic registration path before publication.
    cfgs: ["private_dsd_registration"],
    system_ext_specific: true,
    rustlibs: ["libbinder_rs", "liblibc", "librustutils", "libdiamaneos_ims_dcm",
        "libdiamaneos_ims_runtime", "libdiamaneos_wlan_reporting",
        "libdiamaneos_wlan_runtime", "de.diamaneos.wlan-rust"],
    init_rc: ["wlan-runtime/wlanreportd.rc"],
}
