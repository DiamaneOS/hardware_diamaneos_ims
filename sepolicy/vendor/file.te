#
# The factory Wi-Fi MAC tree /mnt/vendor/wlan_mac (finding -180;
# file_contexts): RAM-backed (tmpfs), created by init and filled at every boot
# by imeiprovd --wlan-mac (imeiprov.te), which only it may write. The device
# lets ueventd read it, to serve the WLAN driver's MAC file as firmware. Not a
# data file: nothing of it survives a reboot.
type vendor_diamaneos_wlan_mac_file, file_type;
