# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 The DiamaneOS Project
#
# imeiprovd (/vendor/bin/imeiprovd, user vendor_imeiprov, no supplementary
# groups, no capabilities): the one-shot IMEI provisioning tool for finding -171.
# It reads the two IMEIs from the read-only traceability partition and, in
# --write mode, provisions modem NV 550 over the Fairphone TCL QMI service
# (QRTR service 0x2ff). In --bt-address mode (finding -177) it reads the factory
# Bluetooth address from the same partition and sets one property; in
# --wlan-mac mode it reads the factory Wi-Fi MAC and writes the WLAN driver's
# MAC file into a RAM-backed tree. It replaces the modem-NV and address parts
# of stock `tctd` (and stock's setwlanmac.sh); it writes no region data, no
# persistent file, and opens no non-QRTR socket besides the property socket.
#
# It gets exactly: a QRTR socket, read-only access to the traceability block
# device, the SELinux enforce flag it checks before running, setting its one
# Bluetooth address property and creating the Wi-Fi MAC file. Nothing else.
type diamaneos_imeiprov, domain;
type diamaneos_imeiprov_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(diamaneos_imeiprov)

# QRTR client: bind an ephemeral port and exchange QMI datagrams with the modem
# service. No ioctls; QRTR discovery and messaging are plain socket calls.
allow diamaneos_imeiprov self:qipcrtr_socket { create bind getattr read write };

# Read-only traceability partition: resolve the /dev/block/by-name symlinks and
# read the labelled block device. Never write it (neverallow below).
allow diamaneos_imeiprov block_device:dir search;
allow diamaneos_imeiprov block_device:lnk_file read;
allow diamaneos_imeiprov vendor_traceability_block_device:blk_file { open read getattr };

# Refuse to run unless caller isolation is enforced (read /sys/fs/selinux/enforce).
allow diamaneos_imeiprov selinuxfs:file r_file_perms;

# --bt-address: set ro.vendor.diamaneos.bt.factory_address (property_contexts,
# exact name), through the property socket. No other property.
set_prop(diamaneos_imeiprov, vendor_diamaneos_bt_address_prop)

# --wlan-mac: create /mnt/vendor/wlan_mac/wlan/qca_cld/qca6750/wlan_mac.bin
# (file.te, file_contexts) new, write it once and close it. It walks /mnt
# (tmpfs, searchable by every domain) and /mnt/vendor; it may not read the file
# back, list, rename, replace or delete anything, or make directories (init
# makes them, imeiprovd.rc).
allow diamaneos_imeiprov mnt_vendor_file:dir search;
allow diamaneos_imeiprov vendor_diamaneos_wlan_mac_file:dir { search write add_name };
allow diamaneos_imeiprov vendor_diamaneos_wlan_mac_file:file { create open write };

# --- least privilege, enforced by neverallow ---
neverallow diamaneos_imeiprov self:global_capability_class_set *;
neverallow diamaneos_imeiprov self:global_capability2_class_set *;
# No non-QRTR sockets of any kind (no Internet, no local IPC beyond QRTR).
neverallow diamaneos_imeiprov self:{ diamaneos_nonlocal_socket_classes } create;
# Never write any block device: the traceability partition is read-only to us,
# and modem NV is reached only through QMI, never by writing a partition.
neverallow diamaneos_imeiprov dev_type:blk_file { write append };
# Sets no other property (the mode is a fixed rc argument, not a property).
neverallow diamaneos_imeiprov {
  property_type
  -vendor_diamaneos_bt_address_prop
}:property_service set;
# Only imeiprovd sets the factory Bluetooth address (init may set any property,
# and the platform lets vendor_init set every vendor property).
neverallow { domain -init -vendor_init -diamaneos_imeiprov } vendor_diamaneos_bt_address_prop:property_service set;
# Only imeiprovd, init, vendor_init (the device's copy trigger) and dumpstate
# (which reads every property) may read it.
neverallow {
  domain
  -init
  -vendor_init
  -dumpstate
  -diamaneos_imeiprov
} vendor_diamaneos_bt_address_prop:file { open read map };
# Only imeiprovd creates or changes the Wi-Fi MAC file (init and vendor_init
# may write most vendor files through platform policy). The device lets only
# ueventd read it.
neverallow {
  domain
  -init
  -vendor_init
  -diamaneos_imeiprov
} vendor_diamaneos_wlan_mac_file:file { create write append link rename setattr relabelto };
neverallow {
  domain
  -init
  -vendor_init
  -diamaneos_imeiprov
} vendor_diamaneos_wlan_mac_file:dir { add_name remove_name rename reparent relabelto };
# imeiprovd adds or removes names in no other directory (coredump_file and
# method_trace_data_file: platform grants to every domain, see below), and may
# not read, extend, rename, link, delete or change the attributes of the MAC
# file.
neverallow diamaneos_imeiprov {
  file_type
  -vendor_diamaneos_wlan_mac_file
  -coredump_file
  -method_trace_data_file
}:dir { add_name remove_name };
neverallow diamaneos_imeiprov vendor_diamaneos_wlan_mac_file:file { read map append unlink rename link setattr };
# No persistent file writes. coredump_file (userdebug) and method_trace_data_file
# (coverage builds) are granted to every domain by the platform policy.
neverallow diamaneos_imeiprov {
  data_file_type
  -coredump_file
  -method_trace_data_file
}:file { create write append rename link unlink setattr };
# No Binder: the domain never calls binder_use and adds no service, so it has no
# Binder access by default. (system_server and su binder are reachable from every
# domain in the platform policy, so a blanket binder neverallow is not asserted.)
