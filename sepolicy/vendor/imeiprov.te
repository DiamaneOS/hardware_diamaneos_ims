# Copyright 2026 The DiamaneOS Project
#
# imeiprovd (/vendor/bin/imeiprovd, user vendor_imeiprov, no supplementary
# groups, no capabilities): the one-shot IMEI provisioning tool.
# It reads the two IMEIs from the read-only traceability partition and, in
# --write mode, provisions modem NV 550 over the Fairphone TCL QMI service
# (QRTR service 0x2ff) and reports the outcome in one property. It replaces
# only the modem-NV part of stock `tctd`. It writes no MAC or region data, no
# persistent file, and opens no non-QRTR socket besides the property socket.
#
# It gets exactly: a QRTR socket, read-only access to the traceability block
# device, the SELinux enforce flag it checks before running and setting its
# IMEI status property. Nothing else.
type diamaneos_imeiprov, domain;
type diamaneos_imeiprov_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(diamaneos_imeiprov)

# QRTR client: bind an ephemeral port and exchange QMI datagrams with the modem
# service. No ioctls. QRTR discovery and messaging are plain socket calls.
allow diamaneos_imeiprov self:qipcrtr_socket { create bind getattr read write };

# Read-only traceability partition: resolve the /dev/block/by-name symlinks and
# read the labelled block device. Never write it (neverallow below).
allow diamaneos_imeiprov block_device:dir search;
allow diamaneos_imeiprov block_device:lnk_file read;
allow diamaneos_imeiprov vendor_traceability_block_device:blk_file { open read getattr };

# Refuse to run unless caller isolation is enforced (read /sys/fs/selinux/enforce).
allow diamaneos_imeiprov selinuxfs:file r_file_perms;

# --write: set vendor.diamaneos.imei.status (exact name, enum values), through
# the property socket.
set_prop(diamaneos_imeiprov, vendor_diamaneos_imei_status_prop)

# --- least privilege, enforced by neverallow ---
neverallow diamaneos_imeiprov self:global_capability_class_set *;
neverallow diamaneos_imeiprov self:global_capability2_class_set *;
# No non-QRTR sockets of any kind (no Internet, no local IPC beyond QRTR).
neverallow diamaneos_imeiprov self:{ diamaneos_nonlocal_socket_classes } create;
# Never write any block device: the traceability partition is read-only to us,
# and modem NV is reached only through QMI, never by writing a partition.
neverallow diamaneos_imeiprov dev_type:blk_file { write append };
# Sets no other property (the mode is a fixed rc argument, not a property).
neverallow diamaneos_imeiprov {
  property_type
  -vendor_diamaneos_imei_status_prop
}:property_service set;
# Only imeiprovd reports the IMEI status. Only the phone process (radio) reads
# it, besides imeiprovd and the domains that read every property.
neverallow { domain -init -vendor_init -diamaneos_imeiprov } vendor_diamaneos_imei_status_prop:property_service set;
neverallow {
  domain
  -init
  -vendor_init
  -dumpstate
  -radio
  -diamaneos_imeiprov
} vendor_diamaneos_imei_status_prop:file { open read map };
# No persistent file writes. coredump_file (userdebug) and method_trace_data_file
# (coverage builds) are granted to every domain by the platform policy.
neverallow diamaneos_imeiprov {
  data_file_type
  -coredump_file
  -method_trace_data_file
}:file { create write append rename link unlink setattr };
# No Binder: the domain never calls binder_use and adds no service, so it has no
# Binder access by default. (system_server and su binder are reachable from every
# domain in the platform policy, so a blanket binder neverallow is not asserted.)
