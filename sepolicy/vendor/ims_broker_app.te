# Vendor-side grants for the IMS network broker (domain
# diamaneos_ims_broker_app, declared in sepolicy/system_ext/public): it finds
# the DCM daemon's service, registers its callback and reports network state;
# the daemon calls back (imsdcm.te). Same pattern as the device tree's
# telephony/qcril_audio.te for the QCRIL audio messenger.
allow diamaneos_ims_broker_app diamaneos_imsdcm_service:service_manager find;
# The frozen callback carries Binder references and values, never file descriptors.
allow diamaneos_ims_broker_app diamaneos_imsdcm:binder { call transfer };
allow diamaneos_imsdcm diamaneos_ims_broker_app:binder transfer;
