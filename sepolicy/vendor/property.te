# The DCM daemon's switches (property_contexts). Vendor internal: no platform
# domain or app can read or set them. The daemon only reads them. vendor_init
# sets the build defaults from /vendor/build.prop (vendor_init.te). On
# debuggable builds root can change them.
vendor_internal_prop(vendor_diamaneos_imsdcm_prop)

# ro.vendor.diamaneos.bt.factory_address: the factory Bluetooth address, read by
# imeiprovd --bt-address from the traceability partition (imeiprov.te). Vendor
# internal: no platform domain or app can read it. Only imeiprovd sets it, once
# per boot (ro.). The device's Bluetooth init rc reads it (vendor_init) to copy
# it to the property its HCI implementation reads.
vendor_internal_prop(vendor_diamaneos_bt_address_prop)

# vendor.diamaneos.imei.status: what imeiprovd --write did to the modem's IMEIs
# this boot. "written" means the modem started without them and pairs them with
# the SIM slots the other way round until a restart, so the phone process
# offers one. Vendor restricted: only imeiprovd sets it (imeiprov.te) and the
# phone process reads it (radio.te).
vendor_restricted_prop(vendor_diamaneos_imei_status_prop)
