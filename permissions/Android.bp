// Allowlist and system configuration of the IMS network broker. System_ext
// apps take their privileged-permission allowlist from
// /system_ext/etc/permissions.

prebuilt_etc {
    name: "privapp-permissions-de.diamaneos.imsbroker.xml",
    src: "privapp-permissions-de.diamaneos.imsbroker.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "sysconfig-de.diamaneos.imsbroker.xml",
    src: "sysconfig-de.diamaneos.imsbroker.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}
