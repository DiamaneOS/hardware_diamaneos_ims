// VINTF and init glue of the IMS DCM daemon. The daemon's binary module
// installs them with
//     vintf_fragment_modules: ["vendor.diamaneos.hardware.imsdcm.xml"],
//     required: ["imsdcmd.rc"],
// The framework compatibility matrix entry (framework_compatibility_matrix.xml)
// and the vendor user (config.fs) are device make variables:
// DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE and TARGET_FS_CONFIG_GEN.

vintf_fragment {
    name: "vendor.diamaneos.hardware.imsdcm.xml",
    src: "vendor.diamaneos.hardware.imsdcm.xml",
    vendor: true,
}

prebuilt_etc {
    name: "imsdcmd.rc",
    src: "imsdcmd.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "imsdcmd-control.rc",
    src: "imsdcmd-control.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

// Init glue of the one-shot IMEI provisioning tool (imeiprovd). The vendor rc
// defines the service; the system_ext control rc starts it, since vendor init
// cannot gate on persistent-properties readiness. The vendor user is a device
// make variable (TARGET_FS_CONFIG_GEN, config.fs).
prebuilt_etc {
    name: "imeiprovd.rc",
    src: "imeiprovd.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "imeiprovd-control.rc",
    src: "imeiprovd-control.rc",
    sub_dir: "init",
    system_ext_specific: true,
}
