#
# One-shot IMEI provisioning (finding -171). Reads the read-only traceability
# partition, validates both IMEIs and compares them with the modem's current
# NV 550 value. With --write it writes NV 550 for both subscriptions only when
# the modem's value differs, then reads it back; it never touches the partition.
# It runs at every boot, as stock tctd does: activating a slot (fastboot
# --set-active, every OTA) makes the bootloader restore the modem's file system
# from its golden copy, which has no IMEI, so NV 550 must be written again.
# It logs booleans to logcat (tag imeiprovd), never an identifier, sets no
# property and opens no non-QRTR socket (see docs/imei-provisioning.md).
#
# - Own vendor user/group (config.fs), no supplementary groups, no capabilities
#   (an empty capabilities list drops them all for a non-root user).
# - oneshot: runs once per boot and exits; init does not restart it.
# - disabled, started only by the system_ext trigger in imeiprovd-control.rc,
#   because a vendor init trigger cannot gate on persistent-properties readiness.
service vendor.imeiprovd /vendor/bin/imeiprovd --write
    class main
    user vendor_imeiprov
    group vendor_imeiprov
    capabilities
    oneshot
    disabled

# Factory Bluetooth address (finding -177). Reads the 6 address bytes from the
# traceability partition, validates them and sets
# ro.vendor.diamaneos.bt.factory_address, which only this domain may set; the
# device's Bluetooth init rc copies it to the property its HCI implementation
# reads, as stock tctd.rc does. A missing or invalid address sets nothing and
# logs only "bt address: missing" or "bt address: invalid"; the address is
# never logged. Same user, group and domain as above; no capabilities; started
# early in vendor init (no persistent-properties gate needed), well before the
# HCI implementation reads the address when Bluetooth is first turned on.
service vendor.imeiprovd-bt /vendor/bin/imeiprovd --bt-address
    class main
    user vendor_imeiprov
    group vendor_imeiprov
    capabilities
    oneshot
    disabled

on post-fs
    start vendor.imeiprovd-bt
